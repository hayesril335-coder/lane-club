rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /alleys/{ownerId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
